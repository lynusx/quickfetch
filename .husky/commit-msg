#!/bin/sh
set -e

# 用本地依赖：pnpm dlx 每次提交都要联网拉一遍 commitlint，断网时提交直接失败
if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint --edit "$1"
else
  echo "未安装 @commitlint/cli，跳过提交信息校验（先跑一次 pnpm install）" >&2
fi

# 按提交类型递增版本号；amend / rebase 重放会自动跳过。
# 这里只负责写文件，把版本号并入本次提交由 post-commit 补一次 amend 完成。
node ./scripts/auto-version.cjs --file "$1"
