{
  "name": "shx-tools",
  "private": true,
  "version": "1.14.0",
  "description": "RCA EL 图片拷贝与 Excel 解析桌面工具",
  "author": "lynusx",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "predev": "node scripts/ensure-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "lint": "eslint .",
    "prestart": "node scripts/ensure-electron.cjs",
    "start": "electron-vite preview",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "knip": "knip"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "clsx": "^2.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "framer-motion": "^12.23.25",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.71.0",
    "prettier": "^3.7.4",
    "radash": "^12.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.10.0",
    "react-use": "^17.6.0",
    "sonner": "^2.0.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "zustand": "^5.0.9"
  },
  "packageManager": "pnpm@10.12.3+sha512.467df2c586056165580ad6dfb54ceaad94c5a30f80893ebdec5a44c5aa73c205ae4a5bb9d5ed6bb84ea7c249ece786642bbb49d06a307df218d03da41c317417",
  "pnpm": {
