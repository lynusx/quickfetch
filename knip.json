{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/main.tsx",
    "scripts/*.cjs",
    "electron.vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/*.cjs"],
  "ignoreDependencies": [
    "@fontsource-variable/public-sans",
    "@tailwindcss/vite",
    "tw-animate-css"
  ]
}
